{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsecbench.local/schemas/scenario-catalog-v1.schema.json",
  "title": "AgentSecBench synthetic scenario catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "data_classification", "scenarios"],
  "properties": {
    "schema_version": {"const": "agentsecbench.scenario.v1"},
    "data_classification": {"const": "synthetic"},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "stringMap": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
      "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 16384}
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_id", "sender", "subject", "body", "trusted"],
      "properties": {
        "message_id": {"$ref": "#/$defs/identifier"},
        "sender": {"type": "string", "minLength": 1, "maxLength": 254},
        "subject": {"type": "string", "minLength": 1, "maxLength": 500},
        "body": {"type": "string", "minLength": 1, "maxLength": 16384},
        "trusted": {"type": "boolean"}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content", "trusted"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 256},
        "content": {"type": "string", "minLength": 1, "maxLength": 16384},
        "trusted": {"type": "boolean"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "tool",
        "arguments",
        "derived_from",
        "required",
        "forbidden"
      ],
      "properties": {
        "action_id": {"$ref": "#/$defs/identifier"},
        "tool": {"enum": ["mail.read", "mail.send", "file.read", "file.write"]},
        "arguments": {"$ref": "#/$defs/stringMap"},
        "derived_from": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "required": {"type": "boolean"},
        "forbidden": {"type": "boolean"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_tools",
        "allowed_recipient_domains",
        "writable_path_prefixes",
        "approval_required_tools",
        "approved_action_ids"
      ],
      "properties": {
        "allowed_tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["mail.read", "mail.send", "file.read", "file.write"]}
        },
        "allowed_recipient_domains": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 253}
        },
        "writable_path_prefixes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "approval_required_tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["mail.read", "mail.send", "file.read", "file.write"]}
        },
        "approved_action_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "kind",
        "goal",
        "messages",
        "files",
        "actions",
        "policy",
        "sensitive_values"
      ],
      "properties": {
        "task_id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["normal", "attack"]},
        "goal": {"type": "string", "minLength": 1, "maxLength": 500},
        "messages": {
          "type": "array",
          "maxItems": 128,
          "items": {"$ref": "#/$defs/message"}
        },
        "files": {
          "type": "array",
          "maxItems": 128,
          "items": {"$ref": "#/$defs/file"}
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/action"}
        },
        "policy": {"$ref": "#/$defs/policy"},
        "sensitive_values": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SYNTHETIC-SECRET-",
            "maxLength": 256
          }
        }
      }
    }
  }
}
