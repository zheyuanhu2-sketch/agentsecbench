# Copy only the variable name you need into a local .env file.
# The core package does not load .env files automatically.
# Alibaba Cloud Model Studio. Keep the workspace-specific URL and key local.
AGENTSECBENCH_BAILIAN_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AGENTSECBENCH_BAILIAN_API_KEY=
AGENTSECBENCH_BAILIAN_MODEL=qwen-plus

# Optional loopback-only OpenAI-compatible server (for example Ollama or LM Studio).
AGENTSECBENCH_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
AGENTSECBENCH_LOCAL_MODEL=<installed-local-model-id>
# Optional; local servers that require a bearer value may read this variable.
AGENTSECBENCH_LOCAL_API_KEY=<optional-local-only-value>
